<?xml version="1.0"?>
<package format="3">
  <name>fast_lipede</name>
  <version>0.1.0</version>
  <description>Real-time LARS semantic filtering for Ouster PointCloud2 streams.</description>
  <maintainer email="maintainer@example.com">FAST-LIPEDE maintainer</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
